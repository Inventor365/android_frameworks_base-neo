<?xml version="1.0" encoding="utf-8"?>
<!-- Yuki Charging Service, Power Profile and charging indication strings (peridot). -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Lock screen charging speed (KeyguardIndicationController) -->
    <!-- Indication on the keyguard that is shown when the device is charging fast (2A - 8A) -->
    <string name="keyguard_indication_fast_maybe_charging_time"><xliff:g id="percentage">%2$s</xliff:g> • Charging Fast maybe? • Full in <xliff:g id="charging_time_left" example="4 hr, 2 min">%1$s</xliff:g></string>
    <string name="keyguard_plugged_in_fast_maybe_charging"><xliff:g id="percentage">%s</xliff:g> • Charging Fast maybe?</string>
    <!-- Indication on the keyguard that is shown when the device is superfast charging (> 8A) -->
    <string name="keyguard_indication_superfast_charging_time"><xliff:g id="percentage">%2$s</xliff:g> • Yuki\'s Superfast Charge • Full in <xliff:g id="charging_time_left" example="4 hr, 2 min">%1$s</xliff:g></string>
    <string name="keyguard_plugged_in_superfast_charging"><xliff:g id="percentage">%s</xliff:g> • Yuki\'s Superfast Charge</string>
</resources>
